{
  "name": "kubescape-plugin",
  "version": "v0.11.2",
  "description": "Kubescape plugin",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "build:debug": "vite build -c vite.config.debug.mjs",
    "format": "prettier --config package.json --write --cache src",
    "lint": "eslint --cache -c package.json --max-warnings 0 --ext .js,.ts,.tsx src/",
    "lint-fix": "eslint --cache -c package.json --max-warnings 0 --ext .js,.ts,.tsx src/ --fix",
    "tsc": "tsc --noEmit",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "test": "vitest run -c node_modules/@kinvolk/headlamp-plugin/config/vite.config.mjs",
    "i18n": "headlamp-plugin i18n",
    "test:watch": "vitest -c node_modules/@kinvolk/headlamp-plugin/config/vite.config.mjs",
    "e2e:setup": "node e2e/bash.mjs setup-kind.sh build-plugin.sh headlamp.sh wait-for-scans.sh",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "kubernetes-ui",
    "kubernetes-debugging",
    "plugins"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ],
    "ignorePatterns": [
      "src/wasm/*"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@dagrejs/graphlib": "^4.0.7",
    "@xyflow/react": "^12.12.1"
  }
}
